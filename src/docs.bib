@article{doi:10.1142/S1793042123500458,
  author =		 {Hammonds, Trajan and Kim, Seoyoung and Miller,
                  Steven J. and Nigam, Arjun and \textbf{KO} and
                  Saikia, Dishant and Sharma, Lalit M.},
  title =		 {\(k\)-Diophantine \(m\)-tuples in finite fields},
  journal =		 {International Journal of Number Theory},
  volume =		 19,
  number =		 04,
  pages =		 {891-912},
  year =		 2023,
  doi =			 {10.1142/S1793042123500458},
  url =			 {https://doi.org/10.1142/S1793042123500458},
  abstract =	 { In this paper, we define a k-Diophantine m-tuple to
                  be a set of m positive integers such that the
                  product of any k distinct positive integers is one
                  less than a perfect square. We study these sets in
                  finite fields 𝔽p for odd prime p and guarantee the
                  existence of a k-Diophantine m-tuple provided p is
                  larger than some explicit lower bound. We also give
                  a formula for the number of 3-Diophantine triples in
                  𝔽p as well as an asymptotic formula for the number
                  of k-Diophantine k-tuples. },
  keywords =	 {journal}
}
